{
  "version": 2,
  "kind": "rbgc-controller-preset",
  "family": "generic_usb",
  "name": "Generic USB Controller",
  "note": "Any pad without a specific entry. Assumes the common arrangement: face buttons first, sticks on the low axes, D-pad on a hat. Treat it as a starting point and correct it against the preview.",
