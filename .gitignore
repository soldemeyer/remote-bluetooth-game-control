# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
venv/
.venv/

# PyInstaller
build/
dist/
# Also the staging tree a build uses when the app it is replacing is still
# running. It is build output exactly as dist/ is, and leaving it untracked
# but unignored is how 421 MB of Windows DLLs ended up in a commit.
dist-staging/
dist2/
*.manifest

# Tests
.pytest_cache/
.coverage
htmlcov/

# Local config -- may contain a saved password
*.local.json
/config/

# Editors / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Link byproducts of tools/build_videofx.py. Only the .dll is needed at
# runtime; the import library and export table are for linking against it,
# which nothing does -- it is loaded with ctypes.
client/media/fx/*.exp
client/media/fx/*.lib
